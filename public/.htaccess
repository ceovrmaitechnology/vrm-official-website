<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|gif|svg|woff|woff2|ttf|mp4|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Strip Trailing Slash on non-root paths (SEO canonical in 1 hop)
  DirectorySlash Off
  RewriteCond %{REQUEST_URI} ^(/.+?)/+$
  RewriteRule ^ https://www.vrmaitechnology.com%1 [R=301,L,NE]

  # 2. 301 Canonical Redirection: Force HTTPS and www in ONE HOP
  # Enforces:
  # http://vrmaitechnology.com/* -> https://www.vrmaitechnology.com/*
  # https://vrmaitechnology.com/* -> https://www.vrmaitechnology.com/*
  # http://www.vrmaitechnology.com/* -> https://www.vrmaitechnology.com/*
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.vrmaitechnology\.com$ [NC]
  RewriteRule ^ https://www.vrmaitechnology.com%{REQUEST_URI} [L,NE,R=301]

  # 301 Permanent Redirect for permanently removed Chennai page
  RewriteRule ^ai-software-services-chennai/?$ https://www.vrmaitechnology.com/ [R=301,L]

  # 301 Redirects for alias / duplicate URLs
  RewriteRule ^products/b2d/?$ /products/bench-to-deploy [R=301,L]
  RewriteRule ^products/vrm-real-estate/?$ /products/vrm-reality [R=301,L]
  RewriteRule ^products/vevora/?$ /products/vrm-reality [R=301,L]
  RewriteRule ^solutions/ai-consulting-services/?$ /solutions [R=301,L]
  RewriteRule ^ai-consulting/?$ /solutions [R=301,L]
  RewriteRule ^our-service/?$ /solutions [R=301,L]
  RewriteRule ^solutions/generative-ai-development/?$ /generative-ai-development [R=301,L]

  # 301 Redirects for template demo routes
  RewriteRule ^(home-(two|three|four|five|six|seven|eight|nine|ten)|service-(2|3|two|three)|appoinment|pricing-plane|testimonial.*|portfolio.*|project.*|team.*|blog.*|onepage.*)/?$ / [R=301,L]

  # Do not rewrite index.html or 404.html
  RewriteRule ^(index|404)\.html$ - [L]

  # Serve existing file directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve prerendered directory index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Unknown routes -> 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ /404.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml text/html text/plain text/xml application/json
</IfModule>
