<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|gif|svg|woff|woff2|ttf|mp4|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Canonical Redirection: Force HTTPS and www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

  # 301 Redirects for alias / duplicate URLs
  RewriteRule ^ai-chatbot-development/?$ /solutions/ai-chatbot-development [R=301,L]
  RewriteRule ^ai-consulting/?$ /solutions/ai-consulting-services [R=301,L]
  RewriteRule ^voice-ai-solutions/?$ /solutions/ai-calling-agent [R=301,L]
  RewriteRule ^ai-company-chennai/?$ /ai-software-services-chennai [R=301,L]
  RewriteRule ^products/b2d/?$ /products/bench-to-deploy [R=301,L]
  RewriteRule ^products/vevora/?$ /products/vrm-real-estate [R=301,L]
  RewriteRule ^solutions/generative-ai-development/?$ /generative-ai-development [R=301,L]
  # 301 Redirects for template demo routes
  RewriteRule ^(home-(two|three|four|five|six|seven|eight|nine|ten)|service-(2|3|two|three)|appoinment|pricing-plane|testimonial.*|portfolio.*|project.*|team.*|blog.*|onepage.*)/?$ / [R=301,L]

  RewriteRule ^index\.html$ - [L]
  # Serve actual existing files (e.g. sitemap.xml, robots.txt) directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml text/html text/plain text/xml application/json
</IfModule>